# Canonical origin of the production site, without a trailing slash. Used for
# canonical URLs, Open Graph URLs, sitemap.xml, robots.txt, llms.txt and
# JSON-LD. On Vercel it falls back to the production domain when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to true to serve noindex everywhere, e.g. on a staging host outside
# Vercel. Vercel preview deployments are noindexed automatically.
SITE_NOINDEX=

# Search console ownership tokens: the content value of each verification meta
# tag. Leave empty to omit the tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=
